{
  "include": ["src/**/*.ts"],
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "chrome"],
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "rootDir": "./src",
    "outDir": "./lib",
    "declaration": true
  }
}
